# ABOUTME: Builds the portable mosh engine libraries for native Windows ARM64.
# ABOUTME: Provides the standalone EXE build spike without running autotools.

CXX = clang++
AR = ar
ARM_MCPU ?= -mcpu=oryon-1

NM ?= llvm-nm
OBJDUMP ?= llvm-objdump

PREFIX ?= /opt/mosh-arm64

# ncurses/terminfo discovery. MSYS2 CLANGARM64 ships ncursesw: headers live
# under an ncursesw/ subdir, terminfo is folded into libncursesw, and both are
# described by ncursesw.pc. The local dockcross image instead has a flat
# curses.h plus a hand-built static libtinfo.a and no .pc file, so fall back to
# -ltinfo there and define NCURSES_STATIC to suppress dllimport against the
# static archive.
NCURSES_CFLAGS := $(shell pkg-config --cflags ncursesw 2>/dev/null)
NCURSES_LIBS := $(shell pkg-config --libs ncursesw 2>/dev/null)
ifeq ($(strip $(NCURSES_LIBS)),)
NCURSES_CFLAGS := -DNCURSES_STATIC
NCURSES_LIBS := -ltinfo
endif
CPPFLAGS = -I. -Isrc/include -I$(PREFIX)/include $(NCURSES_CFLAGS) -include win32/config.h.clangarm64
CXXFLAGS = -std=c++17 -O2 $(ARM_MCPU)
LDFLAGS = -L$(PREFIX)/lib

BUILD = win32/build

CRYPTO_SRCS = src/crypto/ocb_internal.cc src/crypto/base64.cc src/crypto/crypto.cc
PROTO_SRCS = src/protobufs/userinput.pb.cc src/protobufs/hostinput.pb.cc src/protobufs/transportinstruction.pb.cc
UTIL_SRCS = src/util/locale_utils.cc src/util/swrite.cc src/util/select.cc src/util/timestamp.cc src/util/pty_compat.cc
TERMINAL_SRCS = src/terminal/parseraction.cc src/terminal/parser.cc src/terminal/parserstate.cc src/terminal/terminal.cc src/terminal/terminaldispatcher.cc src/terminal/terminaldisplay.cc src/terminal/terminaldisplayinit.cc src/terminal/terminalframebuffer.cc src/terminal/terminalfunctions.cc src/terminal/terminaluserinput.cc
STATESYNC_SRCS = src/statesync/completeterminal.cc src/statesync/user.cc
NETWORK_SRCS = src/network/network.cc src/network/compressor.cc src/network/transportfragment.cc
WIN32_SRCS = win32/wincompat.cc

# Frontend overlay (prediction, notification, title) - needed by mosh_core
FRONTEND_SRCS = src/frontend/terminaloverlay.cc

CRYPTO_OBJS = $(patsubst %.cc,$(BUILD)/%.o,$(CRYPTO_SRCS))
PROTO_OBJS = $(patsubst %.cc,$(BUILD)/%.o,$(PROTO_SRCS))
UTIL_OBJS = $(patsubst %.cc,$(BUILD)/%.o,$(UTIL_SRCS))
TERMINAL_OBJS = $(patsubst %.cc,$(BUILD)/%.o,$(TERMINAL_SRCS))
STATESYNC_OBJS = $(patsubst %.cc,$(BUILD)/%.o,$(STATESYNC_SRCS))
NETWORK_OBJS = $(patsubst %.cc,$(BUILD)/%.o,$(NETWORK_SRCS))
WIN32_OBJS = $(patsubst %.cc,$(BUILD)/%.o,$(WIN32_SRCS))
FRONTEND_OBJS = $(patsubst %.cc,$(BUILD)/%.o,$(FRONTEND_SRCS))

LIBS = src/crypto/libmoshcrypto.a src/protobufs/libmoshprotos.a src/util/libmoshutil.a src/terminal/libmoshterminal.a src/statesync/libmoshstatesync.a src/frontend/libmoshfrontend.a src/network/libmoshnetwork.a

.PHONY: all clean protobufs check config

all: $(LIBS) mosh.exe test_loopback test_core test_console_lifecycle $(BUILD)/win32/console_io_include_check.o

check: all
	test -f mosh.exe
	test -f test_core.exe
	# Run each inspector as its own command so a missing/crashing tool aborts the
	# recipe (make stops on the non-zero exit) instead of feeding an empty stream
	# to grep and silently passing. Grep then reads the saved output.
	$(NM) -u mosh.exe > $(BUILD)/nm-undef.txt
	if grep -Eq "__cxa|_Z|_Unwind" $(BUILD)/nm-undef.txt; then \
	  echo "ERROR: mosh.exe has unresolved C++ runtime symbols"; exit 1; fi
	$(OBJDUMP) -p mosh.exe > $(BUILD)/objdump-p.txt
	# Assert the import table parsed and is non-empty (grep fails the recipe if
	# no "DLL Name:" line exists, catching an inspection that did not happen).
	grep -i "DLL Name:" $(BUILD)/objdump-p.txt
	if grep -Eiq "libstdc\+\+|libc\+\+|libgcc|libunwind|libwinpthread|libssp|libatomic|protobuf|abseil|absl|utf8" $(BUILD)/objdump-p.txt; then \
	  echo "ERROR: mosh.exe dynamically imports a C++/protobuf runtime DLL"; exit 1; fi
	# Enforce the native target boundary: the exe must not depend on the MSYS or
	# Cygwin POSIX-emulation runtime. This matters because check runs inside the
	# MSYS2 environment, where such a dependency would otherwise resolve silently.
	if grep -Eiq "msys-2\.0|cygwin" $(BUILD)/objdump-p.txt; then \
	  echo "ERROR: mosh.exe imports the MSYS/Cygwin runtime (target is native MinGW, not MSYS/Cygwin)"; exit 1; fi

config: src/include/config.h

src/include/config.h: win32/config.h.clangarm64
	cp $< $@

protobufs: src/protobufs/userinput.pb.h src/protobufs/hostinput.pb.h src/protobufs/transportinstruction.pb.h

src/protobufs/%.pb.h src/protobufs/%.pb.cc: src/protobufs/%.proto
	protoc --cpp_out=src/protobufs -Isrc/protobufs $<

src/crypto/libmoshcrypto.a: $(CRYPTO_OBJS)
	$(AR) rcs $@ $^

src/protobufs/libmoshprotos.a: protobufs $(PROTO_OBJS)
	$(AR) rcs $@ $(PROTO_OBJS)

src/util/libmoshutil.a: $(UTIL_OBJS)
	$(AR) rcs $@ $^

src/terminal/libmoshterminal.a: $(TERMINAL_OBJS)
	$(AR) rcs $@ $^

src/statesync/libmoshstatesync.a: $(STATESYNC_OBJS)
	$(AR) rcs $@ $^

src/network/libmoshnetwork.a: $(NETWORK_OBJS)
	$(AR) rcs $@ $^

src/frontend/libmoshfrontend.a: $(FRONTEND_OBJS)
	$(AR) rcs $@ $^

mosh.exe: $(BUILD)/win32/mosh_main.o $(BUILD)/win32/console_io.o $(BUILD)/win32/mosh_core.o src/crypto/libmoshcrypto.a src/protobufs/libmoshprotos.a src/util/libmoshutil.a src/terminal/libmoshterminal.a src/statesync/libmoshstatesync.a src/frontend/libmoshfrontend.a src/network/libmoshnetwork.a $(BUILD)/win32/wincompat.o
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -o $@ $(BUILD)/win32/mosh_main.o $(BUILD)/win32/console_io.o $(BUILD)/win32/mosh_core.o -Wl,--start-group src/crypto/libmoshcrypto.a $(BUILD)/win32/wincompat.o -Wl,-Bstatic $(shell pkg-config --libs --static protobuf) src/protobufs/libmoshprotos.a src/util/libmoshutil.a src/terminal/libmoshterminal.a src/statesync/libmoshstatesync.a src/frontend/libmoshfrontend.a src/network/libmoshnetwork.a -Wl,-Bdynamic -Wl,--end-group $(LDFLAGS) -lcrypto -lz $(NCURSES_LIBS) -lws2_32 -luser32 -lcrypt32 -lbcrypt -l:libwinpthread.a -static-libstdc++ -static-libgcc

$(BUILD)/win32/console_io.o: win32/console_io.cc win32/console_io.h win32/mosh_core.h src/include/config.h
	@mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c -o $@ $<

$(BUILD)/win32/mosh_main.o: win32/mosh_main.cc win32/console_io.h win32/mosh_core.h src/include/config.h
	@mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c -o $@ $<

$(BUILD)/win32/console_io_include_check.o: win32/console_io_include_check.cc win32/console_io.h win32/mosh_core.h src/include/config.h
	@mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c -o $@ $<


# Network sources need protobuf files
win32/build/src/network/network.o: src/protobufs/transportinstruction.pb.h
win32/build/src/network/compressor.o: src/protobufs/transportinstruction.pb.h
win32/build/src/network/transportfragment.o: src/protobufs/transportinstruction.pb.h

$(BUILD)/win32/wincompat.o: win32/wincompat.cc src/include/config.h
	@mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c -o $@ $<

$(BUILD)/win32/test_loopback.o: win32/test_loopback.cc src/include/config.h src/network/libmoshnetwork.a $(BUILD)/win32/wincompat.o
	@mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c -o $@ $<

test_loopback: $(BUILD)/win32/test_loopback.o src/network/libmoshnetwork.a src/crypto/libmoshcrypto.a $(BUILD)/win32/wincompat.o src/protobufs/libmoshprotos.a src/util/libmoshutil.a src/terminal/libmoshterminal.a src/statesync/libmoshstatesync.a
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -o $@ $(BUILD)/win32/test_loopback.o -Wl,--start-group -Wl,--whole-archive src/network/libmoshnetwork.a src/crypto/libmoshcrypto.a $(BUILD)/win32/wincompat.o src/protobufs/libmoshprotos.a src/util/libmoshutil.a src/terminal/libmoshterminal.a src/statesync/libmoshstatesync.a -Wl,--no-whole-archive -Wl,--end-group -Wl,-Bstatic $(shell pkg-config --libs --static protobuf) -Wl,-Bdynamic -Wl,--start-group $(LDFLAGS) -lcrypto -lz $(NCURSES_LIBS) -lws2_32 -luser32 -lcrypt32 -lbcrypt -l:libwinpthread.a -Wl,--end-group

$(BUILD)/win32/test_server.o: win32/test_server.cc src/include/config.h src/network/libmoshnetwork.a $(BUILD)/win32/wincompat.o
	@mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c -o $@ $<

$(BUILD)/win32/mosh_core.o: win32/mosh_core.cc src/include/config.h src/network/libmoshnetwork.a src/crypto/libmoshcrypto.a $(BUILD)/win32/wincompat.o src/protobufs/libmoshprotos.a src/util/libmoshutil.a src/terminal/libmoshterminal.a src/statesync/libmoshstatesync.a
	@mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c -o $@ $<

$(BUILD)/win32/test_core.o: win32/test_core.cc src/include/config.h win32/mosh_core.h win32/test_server.h $(BUILD)/win32/mosh_core.o $(BUILD)/win32/test_server.o src/network/libmoshnetwork.a src/crypto/libmoshcrypto.a $(BUILD)/win32/wincompat.o src/protobufs/libmoshprotos.a src/util/libmoshutil.a src/terminal/libmoshterminal.a src/statesync/libmoshstatesync.a
	@mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c -o $@ $<

test_core: $(BUILD)/win32/test_core.o $(BUILD)/win32/mosh_core.o $(BUILD)/win32/test_server.o src/network/libmoshnetwork.a src/crypto/libmoshcrypto.a $(BUILD)/win32/wincompat.o src/protobufs/libmoshprotos.a src/util/libmoshutil.a src/terminal/libmoshterminal.a src/statesync/libmoshstatesync.a src/frontend/libmoshfrontend.a
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -o $@ $(BUILD)/win32/test_core.o $(BUILD)/win32/mosh_core.o $(BUILD)/win32/test_server.o -Wl,--start-group src/network/libmoshnetwork.a src/crypto/libmoshcrypto.a $(BUILD)/win32/wincompat.o src/protobufs/libmoshprotos.a src/util/libmoshutil.a src/terminal/libmoshterminal.a src/statesync/libmoshstatesync.a src/frontend/libmoshfrontend.a -Wl,--end-group -Wl,-Bstatic $(shell pkg-config --libs --static protobuf) -Wl,-Bdynamic -Wl,--start-group $(LDFLAGS) -lcrypto -lz $(NCURSES_LIBS) -lws2_32 -luser32 -lcrypt32 -lbcrypt -l:libwinpthread.a -Wl,--end-group

$(BUILD)/%.o: %.cc src/include/config.h
	@mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c -o $@ $<

$(BUILD)/src/frontend/terminaloverlay.o: src/frontend/terminaloverlay.cc src/include/config.h src/protobufs/transportinstruction.pb.h
	@mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS) -DMOSH_NEEDS_WCWIDTH $(CXXFLAGS) -c -o $@ $<

$(BUILD)/win32/test_console_lifecycle.o: win32/test_console_lifecycle.cc src/include/config.h win32/console_io.h win32/mosh_core.h $(BUILD)/win32/console_io.o
	@mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c -o $@ $<

test_console_lifecycle: $(BUILD)/win32/test_console_lifecycle.o $(BUILD)/win32/console_io.o $(BUILD)/win32/mosh_core.o $(BUILD)/win32/wincompat.o src/crypto/libmoshcrypto.a src/protobufs/libmoshprotos.a src/util/libmoshutil.a src/terminal/libmoshterminal.a src/statesync/libmoshstatesync.a src/frontend/libmoshfrontend.a src/network/libmoshnetwork.a
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -o $@ $(BUILD)/win32/test_console_lifecycle.o $(BUILD)/win32/console_io.o $(BUILD)/win32/mosh_core.o -Wl,--start-group src/crypto/libmoshcrypto.a $(BUILD)/win32/wincompat.o src/protobufs/libmoshprotos.a src/util/libmoshutil.a src/terminal/libmoshterminal.a src/statesync/libmoshstatesync.a src/frontend/libmoshfrontend.a src/network/libmoshnetwork.a -Wl,--end-group -Wl,-Bstatic $(shell pkg-config --libs --static protobuf) -Wl,-Bdynamic $(LDFLAGS) -lcrypto -lz $(NCURSES_LIBS) -lws2_32 -luser32 -lcrypt32 -lbcrypt -l:libwinpthread.a -static-libstdc++ -static-libgcc

clean:
	rm -rf $(BUILD) $(LIBS) mosh.exe test_loopback test_loopback.exe test_core test_core.exe test_console_lifecycle test_console_lifecycle.exe src/protobufs/*.pb.cc src/protobufs/*.pb.h src/include/config.h
