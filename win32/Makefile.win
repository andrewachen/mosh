# ABOUTME: Builds the portable mosh engine libraries for native Windows ARM64.
# ABOUTME: Provides the standalone EXE build spike without running autotools.

CXX = clang++
AR = ar
ARM_MCPU ?= -mcpu=oryon-1

NM ?= llvm-nm
OBJDUMP ?= llvm-objdump

PREFIX ?= /opt/mosh-arm64

# ncurses/terminfo discovery. MSYS2 CLANGARM64 ships ncursesw: headers live
# under an ncursesw/ subdir, terminfo is folded into libncursesw, and both are
# described by ncursesw.pc. The local dockcross image instead has a flat
# curses.h plus a hand-built static libtinfo.a and no .pc file, so fall back to
# -ltinfo there and define NCURSES_STATIC to suppress dllimport against the
# static archive.
NCURSES_CFLAGS := $(shell pkg-config --cflags ncursesw 2>/dev/null)
NCURSES_LIBS := $(shell pkg-config --libs ncursesw 2>/dev/null)
ifeq ($(strip $(NCURSES_LIBS)),)
NCURSES_CFLAGS := -DNCURSES_STATIC
NCURSES_LIBS := -ltinfo
endif
CPPFLAGS = -I. -Isrc/include -I$(PREFIX)/include $(NCURSES_CFLAGS) -include win32/config.h.clangarm64
CXXFLAGS = -std=c++17 -O2 $(ARM_MCPU)
LDFLAGS = -L$(PREFIX)/lib

BUILD = win32/build

CRYPTO_SRCS = src/crypto/ocb_internal.cc src/crypto/base64.cc src/crypto/crypto.cc
PROTO_SRCS = src/protobufs/userinput.pb.cc src/protobufs/hostinput.pb.cc src/protobufs/transportinstruction.pb.cc
UTIL_SRCS = src/util/locale_utils.cc src/util/swrite.cc src/util/select.cc src/util/timestamp.cc src/util/pty_compat.cc
TERMINAL_SRCS = src/terminal/parseraction.cc src/terminal/parser.cc src/terminal/parserstate.cc src/terminal/terminal.cc src/terminal/terminaldispatcher.cc src/terminal/terminaldisplay.cc src/terminal/terminaldisplayinit.cc src/terminal/terminalframebuffer.cc src/terminal/terminalfunctions.cc src/terminal/terminaluserinput.cc
STATESYNC_SRCS = src/statesync/completeterminal.cc src/statesync/user.cc

CRYPTO_OBJS = $(patsubst %.cc,$(BUILD)/%.o,$(CRYPTO_SRCS))
PROTO_OBJS = $(patsubst %.cc,$(BUILD)/%.o,$(PROTO_SRCS))
UTIL_OBJS = $(patsubst %.cc,$(BUILD)/%.o,$(UTIL_SRCS))
TERMINAL_OBJS = $(patsubst %.cc,$(BUILD)/%.o,$(TERMINAL_SRCS))
STATESYNC_OBJS = $(patsubst %.cc,$(BUILD)/%.o,$(STATESYNC_SRCS))

LIBS = src/crypto/libmoshcrypto.a src/protobufs/libmoshprotos.a src/util/libmoshutil.a src/terminal/libmoshterminal.a src/statesync/libmoshstatesync.a

.PHONY: all clean protobufs check config

all: $(LIBS) mosh.exe

check: all
	test -f mosh.exe
	# Run each inspector as its own command so a missing/crashing tool aborts the
	# recipe (make stops on the non-zero exit) instead of feeding an empty stream
	# to grep and silently passing. Grep then reads the saved output.
	$(NM) -u mosh.exe > $(BUILD)/nm-undef.txt
	if grep -Eq "__cxa|_Z|_Unwind" $(BUILD)/nm-undef.txt; then \
	  echo "ERROR: mosh.exe has unresolved C++ runtime symbols"; exit 1; fi
	$(OBJDUMP) -p mosh.exe > $(BUILD)/objdump-p.txt
	# Assert the import table parsed and is non-empty (grep fails the recipe if
	# no "DLL Name:" line exists, catching an inspection that did not happen).
	grep -i "DLL Name:" $(BUILD)/objdump-p.txt
	if grep -Eiq "libstdc\+\+|libc\+\+|libgcc|libunwind|libwinpthread|libssp|libatomic|protobuf|abseil|absl|utf8" $(BUILD)/objdump-p.txt; then \
	  echo "ERROR: mosh.exe dynamically imports a C++/protobuf runtime DLL"; exit 1; fi
	# Enforce the native target boundary: the exe must not depend on the MSYS or
	# Cygwin POSIX-emulation runtime. This matters because check runs inside the
	# MSYS2 environment, where such a dependency would otherwise resolve silently.
	if grep -Eiq "msys-2\.0|cygwin" $(BUILD)/objdump-p.txt; then \
	  echo "ERROR: mosh.exe imports the MSYS/Cygwin runtime (target is native MinGW, not MSYS/Cygwin)"; exit 1; fi

config: src/include/config.h

src/include/config.h: win32/config.h.clangarm64
	cp $< $@

protobufs: src/protobufs/userinput.pb.h src/protobufs/hostinput.pb.h src/protobufs/transportinstruction.pb.h

src/protobufs/%.pb.h src/protobufs/%.pb.cc: src/protobufs/%.proto
	protoc --cpp_out=src/protobufs -Isrc/protobufs $<

src/crypto/libmoshcrypto.a: $(CRYPTO_OBJS)
	$(AR) rcs $@ $^

src/protobufs/libmoshprotos.a: protobufs $(PROTO_OBJS)
	$(AR) rcs $@ $(PROTO_OBJS)

src/util/libmoshutil.a: $(UTIL_OBJS)
	$(AR) rcs $@ $^

src/terminal/libmoshterminal.a: $(TERMINAL_OBJS)
	$(AR) rcs $@ $^

src/statesync/libmoshstatesync.a: $(STATESYNC_OBJS)
	$(AR) rcs $@ $^

mosh.exe: win32/spike.cc src/crypto/libmoshcrypto.a src/protobufs/libmoshprotos.a src/util/libmoshutil.a src/terminal/libmoshterminal.a src/statesync/libmoshstatesync.a
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -o $@ win32/spike.cc -Wl,--start-group src/crypto/libmoshcrypto.a -Wl,-Bstatic $(shell pkg-config --libs --static protobuf) -Wl,-Bdynamic src/protobufs/libmoshprotos.a src/util/libmoshutil.a src/terminal/libmoshterminal.a src/statesync/libmoshstatesync.a -Wl,--end-group $(LDFLAGS) -lcrypto -lz $(NCURSES_LIBS) -lws2_32 -luser32 -lcrypt32 -static-libstdc++ -static-libgcc

$(BUILD)/%.o: %.cc src/include/config.h
	@mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c -o $@ $<

clean:
	rm -rf $(BUILD) $(LIBS) mosh.exe src/protobufs/*.pb.cc src/protobufs/*.pb.h src/include/config.h
