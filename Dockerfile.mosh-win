# ABOUTME: Cross-builds the Windows mosh engine dependencies (ARM64 and x64) as parallel buildx stages.
# ABOUTME: deps-arm64/deps-x64 compile the shared docker/build-deps.sh into /opt/mosh-arm64 and /opt/mosh-x64.

FROM ubuntu:24.04 AS base

# llvm-mingw ships a single multi-arch install (one tarball holds the
# aarch64-/x86_64-w64-mingw32-* drivers), so the toolchain is extracted once at
# a neutral root; the per-arch selection comes from the CC/CXX/etc. paths the
# dep stages declare, not from this root.
ENV CROSS_ROOT=/usr/xcc/llvm-mingw
ENV PATH=/opt/protobuf-host/bin:${CROSS_ROOT}/bin:${PATH}

RUN apt-get update && \
    apt-get install --yes --no-install-recommends \
      build-essential ca-certificates curl cmake make ninja-build perl \
      pkg-config python3 xz-utils && \
    rm -rf /var/lib/apt/lists/*

# Cross toolchain: llvm-mingw 20260616 (clang 22.1.8), UCRT variant — the same
# CRT the MSYS2 CLANGARM64/CLANG64 CI jobs link, so local builds are
# authoritative for the target ABI. (The msvcrt variant lacks the .UTF-8 locale
# form, which mosh's setlocale(LC_ALL, ".UTF-8") startup requires.) The tarball
# is built on ubuntu-22.04 (glibc 2.35); it runs on 24.04 because noble's glibc
# 2.39 is backward-compatible with it.
RUN curl --fail --location --retry 5 --retry-all-errors --output /tmp/llvm-mingw.tar.xz \
      https://github.com/mstorsjo/llvm-mingw/releases/download/20260616/llvm-mingw-20260616-ucrt-ubuntu-22.04-x86_64.tar.xz && \
    mkdir -p ${CROSS_ROOT} && \
    tar -C ${CROSS_ROOT} --strip-components=1 -xJf /tmp/llvm-mingw.tar.xz && \
    rm /tmp/llvm-mingw.tar.xz
COPY Toolchain.cmake ${CROSS_ROOT}/Toolchain.cmake
COPY docker/build-deps.sh /usr/local/bin/build-deps.sh
RUN chmod +x /usr/local/bin/build-deps.sh

# Reproduce the dockcross cmake wrapper: auto-inject CMAKE_TOOLCHAIN_FILE so
# the protobuf target build picks up the cross toolchain without naming it.
# Skip injection for cmake's non-configure subcommands. CMAKE_TOOLCHAIN_FILE is
# per-arch (each dep stage re-declares it), so the wrapper must not bake the
# value — evaluate it from the environment at call time, as dockcross does.
RUN printf '%s\n' \
      '#!/usr/bin/env sh' \
      'case $1 in' \
      '  -E|--build|--find-package|--install)' \
      '    exec /usr/bin/cmake "$@" ;;' \
      'esac' \
      'exec /usr/bin/cmake -DCMAKE_TOOLCHAIN_FILE:FILEPATH=${CMAKE_TOOLCHAIN_FILE} "$@"' \
      > /usr/local/bin/cmake && \
    chmod +x /usr/local/bin/cmake

# Host protoc: arch-independent build tool that runs on the host to generate
# the .pb.cc/_pb.h sources; only the host executable is needed, so this stage
# builds protoc and its shared helper libs once for both dep stages. The build
# tree is deleted here; build-deps.sh re-downloads the source per arch.
RUN curl --fail --location --retry 5 --retry-all-errors --output /tmp/protobuf.tar.gz \
      https://github.com/protocolbuffers/protobuf/archive/refs/tags/v3.21.12.tar.gz && \
    echo '930c2c3b5ecc6c9c12615cf5ad93f1cd6e12d0aba862b572e076259970ac3a53  /tmp/protobuf.tar.gz' | sha256sum --check && \
    tar -C /tmp -xzf /tmp/protobuf.tar.gz && \
    env -u CMAKE_TOOLCHAIN_FILE -u CC -u CXX -u AR -u AS -u LD -u RANLIB \
      cmake -S /tmp/protobuf-3.21.12/cmake -B /tmp/protobuf-host \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/protobuf-host \
      -DCMAKE_C_COMPILER=/usr/bin/gcc -DCMAKE_CXX_COMPILER=/usr/bin/g++ \
      -Dprotobuf_BUILD_TESTS=OFF -Dprotobuf_BUILD_SHARED_LIBS=OFF && \
    cmake --build /tmp/protobuf-host --parallel "$(nproc)" && \
    cmake --install /tmp/protobuf-host && \
    rm -rf /tmp/protobuf-3.21.12 /tmp/protobuf.tar.gz /tmp/protobuf-host

# Each dep stage re-declares the full toolchain env. Docker ENV is expanded at
# definition time, so merely changing CROSS_TRIPLE does NOT re-derive CC/CXX:
# the literal .../bin/<triple>-gcc paths must be set per arch. build-deps.sh
# reads TARGET/PREFIX/ARCH/CMAKE_TOOLCHAIN_FILE; the rest feed the recipes
# (openssl and cmake unset the tool vars and read the triple from TARGET).

FROM base AS deps-arm64
ENV TARGET=aarch64-w64-mingw32 CROSS_TRIPLE=aarch64-w64-mingw32 \
    PREFIX=/opt/mosh-arm64 ARCH=arm64 CROSS_ROOT=/usr/xcc/llvm-mingw \
    CC=/usr/xcc/llvm-mingw/bin/aarch64-w64-mingw32-gcc \
    CXX=/usr/xcc/llvm-mingw/bin/aarch64-w64-mingw32-g++ \
    AR=/usr/xcc/llvm-mingw/bin/aarch64-w64-mingw32-ar \
    AS=/usr/xcc/llvm-mingw/bin/aarch64-w64-mingw32-as \
    LD=/usr/xcc/llvm-mingw/bin/aarch64-w64-mingw32-ld \
    RANLIB=/usr/xcc/llvm-mingw/bin/aarch64-w64-mingw32-ranlib \
    CMAKE_TOOLCHAIN_FILE=/usr/xcc/llvm-mingw/Toolchain.cmake \
    PKG_CONFIG_LIBDIR=/opt/mosh-arm64/lib/pkgconfig \
    PKG_CONFIG_SYSROOT_DIR=/
RUN bash /usr/local/bin/build-deps.sh

FROM base AS deps-x64
ENV TARGET=x86_64-w64-mingw32 CROSS_TRIPLE=x86_64-w64-mingw32 \
    PREFIX=/opt/mosh-x64 ARCH=x64 CROSS_ROOT=/usr/xcc/llvm-mingw \
    CC=/usr/xcc/llvm-mingw/bin/x86_64-w64-mingw32-gcc \
    CXX=/usr/xcc/llvm-mingw/bin/x86_64-w64-mingw32-g++ \
    AR=/usr/xcc/llvm-mingw/bin/x86_64-w64-mingw32-ar \
    AS=/usr/xcc/llvm-mingw/bin/x86_64-w64-mingw32-as \
    LD=/usr/xcc/llvm-mingw/bin/x86_64-w64-mingw32-ld \
    RANLIB=/usr/xcc/llvm-mingw/bin/x86_64-w64-mingw32-ranlib \
    CMAKE_TOOLCHAIN_FILE=/usr/xcc/llvm-mingw/Toolchain.cmake \
    PKG_CONFIG_LIBDIR=/opt/mosh-x64/lib/pkgconfig \
    PKG_CONFIG_SYSROOT_DIR=/
RUN bash /usr/local/bin/build-deps.sh

FROM base AS final
# final is FROM base, so /opt/protobuf-host is already present (no COPY needed).
# Carry over both dep trees from their build stages.
COPY --from=deps-arm64 /opt/mosh-arm64 /opt/mosh-arm64
COPY --from=deps-x64 /opt/mosh-x64 /opt/mosh-x64

# Neutral default; no arch-specific TARGET/PREFIX/CC/CXX at this level.
# build-mosh-local.sh selects the arch (and its dep tree) at run time via env.
